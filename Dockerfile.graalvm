# syntax=docker/dockerfile:1

FROM ghcr.io/graalvm/graalvm-community:25 AS build
WORKDIR /workspace
COPY . .
RUN gu install native-image
RUN ./mvnw -Pnative -DskipTests native:compile

FROM alpine:3.18
RUN addgroup -S app && adduser -S app -G app && apk add --no-cache libstdc++
WORKDIR /app
COPY --from=build /workspace/target/parse-short-video-graalvm /app/parse-short-video
EXPOSE 40203
USER app
ENTRYPOINT ["/app/parse-short-video"]

